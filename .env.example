# Required for online LLM mode (OpenAI-compatible by default:
# OpenAI / DeepSeek / GLM / MiniMax / Qwen / OpenRouter / Ollama / OneAPI)
NOVEL_WASH_BASE_URL=https://api.openai.com/v1
NOVEL_WASH_API_KEY=

# Optional: openai | anthropic | gemini (auto-inferred from URL when omitted)
# NOVEL_WASH_API_FORMAT=openai

# Optional: set primary / secondary models directly without creating config/models.json
# NOVEL_WASH_PRIMARY_MODEL=deepseek-v4.1-flash-1017
# NOVEL_WASH_SECONDARY_MODEL=glm-5.3-flash

# Optional provider-specific keys when mixing multiple providers in config/models.json
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
